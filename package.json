{
  "name": "english-master",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:vocab": "node tools/build-vocab.mjs",
    "serve": "node tools/serve.mjs",
    "app": "ng build && node tools/serve.mjs",
    "build:voice": "python tools/build-voice.py",
    "fetch:images": "python tools/fetch-images.py",
    "build:icons": "node tools/build-icons.mjs",
    "check:theme": "node tools/check-theme.mjs",
    "prebuild": "node tools/check-theme.mjs && node tools/build-offline-manifest.mjs",
    "build:audio": "node tools/build-audio-list.mjs && python tools/build-audio.py",
    "build:offline": "node tools/build-offline-manifest.mjs",
    "fetch:hero": "python tools/fetch-hero.py",
    "prestart": "node tools/build-offline-manifest.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@tabler/icons": "^3.48.0",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
