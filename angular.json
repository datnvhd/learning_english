{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "23c5948b-60e5-4628-b666-2261fce9f792"
  },
  "newProjectRoot": "projects",
  "projects": {
    "english-adventure": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/inter/latin-400.css",
              "node_modules/@fontsource/inter/latin-ext-400.css",
              "node_modules/@fontsource/inter/vietnamese-400.css",
              "node_modules/@fontsource/inter/latin-500.css",
              "node_modules/@fontsource/inter/latin-ext-500.css",
              "node_modules/@fontsource/inter/vietnamese-500.css",
              "node_modules/@fontsource/inter/latin-600.css",
              "node_modules/@fontsource/inter/latin-ext-600.css",
              "node_modules/@fontsource/inter/vietnamese-600.css",
              "node_modules/@fontsource/inter/latin-700.css",
              "node_modules/@fontsource/inter/latin-ext-700.css",
              "node_modules/@fontsource/inter/vietnamese-700.css",
              "node_modules/@fontsource/inter/latin-800.css",
              "node_modules/@fontsource/inter/latin-ext-800.css",
              "node_modules/@fontsource/inter/vietnamese-800.css",
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "900kB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kB",
                  "maximumError": "32kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "english-adventure:build:production"
            },
            "development": {
              "buildTarget": "english-adventure:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
